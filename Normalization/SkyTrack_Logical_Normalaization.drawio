  <diagram id="skytrack-normalization" name="Normalization and References">
    <mxGraphModel dx="1100" dy="1165" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="2490" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="SKYTRACK — NORMALIZATION AND REFERENCES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=40;fontColor=#204D7B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="45" width="2040" height="70" />
        </mxCell>
        <mxCell id="3" value="Mohammed Said Saif Alshandoodi" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=26;fontColor=#204D7B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="115" width="2040" height="45" />
        </mxCell>
        <mxCell id="4" value="Scope: the seven tables on the Final Tables page, using the underlined keys and 1:M labels in the supplied ERD." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=25;fontColor=#204D7B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="180" width="2040" height="60" />
        </mxCell>
        <mxCell id="5" value="" style="rounded=0;fillColor=#EFF5FB;strokeColor=#204D7B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="270" width="660" height="370" />
        </mxCell>
        <mxCell id="6" value="FIRST NORMAL FORM — 1NF" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=25;fontColor=#204D7B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="285" width="620" height="50" />
        </mxCell>
        <mxCell id="7" value="Store one value in each field and no repeating groups.&lt;br&gt;&lt;br&gt;Each Phone, Email, date, name and location is stored as one value. Full_name can remain one field.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; all seven mapped tables satisfy 1NF when populated this way." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=22;fontColor=#204D7B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="340" width="620" height="285" />
        </mxCell>
        <mxCell id="8" value="" style="rounded=0;fillColor=#EFF5FB;strokeColor=#204D7B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="270" width="660" height="370" />
        </mxCell>
        <mxCell id="9" value="SECOND NORMAL FORM — 2NF" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=25;fontColor=#204D7B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="790" y="285" width="620" height="50" />
        </mxCell>
        <mxCell id="10" value="A table must be in 1NF, with no non-key attribute depending on only part of a candidate key.&lt;br&gt;&lt;br&gt;Every key used in this mapping is a single attribute; no composite candidate keys are specified.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; no partial dependencies to remove under these keys." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=22;fontColor=#204D7B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="790" y="340" width="620" height="285" />
        </mxCell>
        <mxCell id="11" value="" style="rounded=0;fillColor=#EFF5FB;strokeColor=#204D7B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1460" y="270" width="660" height="370" />
        </mxCell>
        <mxCell id="12" value="THIRD NORMAL FORM — 3NF" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=25;fontColor=#204D7B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1480" y="285" width="620" height="50" />
        </mxCell>
        <mxCell id="13" value="A table must be in 2NF. For each non-trivial dependency X → A, X must be a superkey or A a prime attribute.&lt;br&gt;&lt;br&gt;Only primary-key dependencies are established here; no extra non-key determinants are supplied.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; no further split is required under these dependencies." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=22;fontColor=#204D7B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1480" y="340" width="620" height="285" />
        </mxCell>
        <mxCell id="14" value="FUNCTIONAL DEPENDENCIES USED" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=30;fontColor=#204D7B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="685" width="2040" height="50" />
        </mxCell>
